    "upload:bib": "node scripts/upload-bib-to-r2.mjs",
    "test:r2": "node scripts/test-r2.mjs",
    "sync:syracuse": "node scripts/run-syracuse-sync.mjs",
    "backfill:reliure": "node scripts/backfill-reliure.mjs",
    "db:apply-schema": "node scripts/db-apply-schema.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:migrate:reserve": "node scripts/db-migrate-reserve.mjs",
